{
    admin off
    auto_https off
    persist_config off
}

:{$PORT:8080} {
    root * /srv
    encode gzip

    handle /health {
        respond "ok" 200
    }

    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle /images/* {
        header Cache-Control "public, max-age=86400"
        file_server
    }

    handle /sitemap.xml {
        header Content-Type "application/xml; charset=utf-8"
        file_server
    }

    handle /robots.txt {
        file_server
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
